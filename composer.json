{
    "name": "subugoe/typo3-cap",
    "description": "TYPO3 extension providing CAPTCHA (trycap.dev) bot protection via a PSR-15 middleware and invisible proof-of-work challenge",
    "type": "typo3-cms-extension",
    "version": "1.0.2",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
        "name": "Frederik Hennecke",
        "email": "frederik.hennecke@sub.uni-goettingen.de",
        "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-intl": "*",
        "typo3/cms-backend": "^12.4 || ^13.4",
        "typo3/cms-core": "^12.4 || ^13.4",
        "typo3/cms-frontend": "^12.4 || ^13.4"
    },
    "autoload": {
        "psr-4": {
            "Subugoe\\Typo3Cap\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "typo3_cap"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
